{
  "name": "deepseek-harness-intelligent-ui",
  "version": "0.2.0",
  "description": "DeepSeek Harness Intelligent UI: generative, interactive UI in the chat (declarative component catalog + sandboxed streaming HTML widgets), inspired by CopilotKit OpenIntelligentUI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "generative-ui",
    "intelligent-ui"
  ],
  "license": "MIT",
  "author": "dreamfarer-space",
  "homepage": "https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "deepseek-harness-intelligent-ui": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "client",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "e2e:mock": "node scripts/e2e/mock-deepseek.mjs 3199 e2e-mock.log",
    "e2e:browser": "node scripts/e2e/browser.mjs",
    "e2e:all": "node scripts/e2e/run-all.mjs",
    "version": "node scripts/build-client.mjs && git add client/client.js",
    "prepublishOnly": "node scripts/build-client.mjs && git diff --exit-code -- client/client.js && vitest run",
    "release:check": "node scripts/ci/release-check.mjs",
    "smoke": "node scripts/ci/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || >=4.0.5-alpha.0 <4.1.0-0",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "idiomorph": "0.8.0",
    "jsdom": "26.1.0",
    "puppeteer-core": "25.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
