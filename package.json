{
  "name": "deepseek-harness-intelligent-ui",
  "version": "0.2.7",
  "description": "DeepSeek Harness Intelligent UI: generative, interactive UI in the chat (declarative component catalog + sandboxed streaming HTML widgets), inspired by CopilotKit OpenIntelligentUI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "generative-ui",
    "intelligent-ui"
  ],
  "license": "MIT",
  "author": "dreamfarer-space",
  "homepage": "https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dreamfarer-space/deepseek-harness-intelligent-ui/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/plugin.js",
    "./client": {
      "types": "./client/client.d.ts",
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./renderer/renderer.js": "./renderer/renderer.js",
    "./controlled": "./src/controlled/runtime.js",
    "./portable": "./src/portable/artifacts.js",
    "./catalog": {
      "types": "./src/catalog/extensions.d.ts",
      "default": "./src/catalog/extensions.js"
    }
  },
  "bin": {
    "deepseek-harness-intelligent-ui": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "client",
    "renderer",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "examples/component-extension",
    "docs/component-extensions.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-renderer.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "e2e:mock": "node scripts/e2e/mock-deepseek.mjs 3199 e2e-mock.log",
    "e2e:browser": "node scripts/e2e/browser.mjs",
    "e2e:controlled": "node scripts/e2e/controlled.mjs",
    "e2e:all": "node scripts/e2e/run-all.mjs",
    "eval:real": "node scripts/run-real-model-suite.mjs all",
    "eval:demo": "node scripts/eval/edit-demo.mjs e2e-shots/real-model/frames docs/real-model-eval-report.json docs/assets/real-model --gif-chapters ④,⑤,⑧",
    "eval:gallery": "node scripts/eval/gallery.mjs e2e-shots/real-model/browser docs/assets/real-model",
    "version": "node scripts/build-client.mjs && node scripts/build-renderer.mjs && git add client/client.js renderer/renderer.js",
    "prepublishOnly": "node scripts/build-client.mjs && node scripts/build-renderer.mjs && git diff --exit-code -- client/client.js renderer/renderer.js && vitest run",
    "release:check": "node scripts/ci/release-check.mjs",
    "smoke": "node scripts/ci/smoke.mjs",
    "docs:art": "node scripts/docs/readme-art.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:offline": "npm run build && node scripts/offline/build.mjs",
    "e2e:offline": "node scripts/e2e/offline.mjs",
    "verify:offline": "node scripts/offline/verify.mjs",
    "e2e:extensions": "node scripts/e2e/extensions.mjs",
    "e2e:extensions:dsh": "node scripts/e2e/extensions-dsh.mjs",
    "demo:features": "node scripts/demo/record-features.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || >=4.0.5-alpha.0 <4.1.0-0",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.2.0 || >=0.2.1-0 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.2.0 || >=0.2.1-0 <0.2.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "canvas-confetti": "1.9.3",
    "chart.js": "4.4.4",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "idiomorph": "0.8.0",
    "jsdom": "26.1.0",
    "katex": "0.16.11",
    "mermaid": "11.4.1",
    "puppeteer-core": "25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tar": "7.5.22",
    "three": "0.169.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
